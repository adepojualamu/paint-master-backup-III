# ============================
# PaintGH Backend — Environment Variables
# Copy this file to ../.env and fill in real values.
# Never commit your real .env to source control.
# ============================

# Server
PORT=3000
NODE_ENV=development        # development | production

# JWT — generate a long random secret per environment.
# Suggested: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Database file path
DB_PATH=./paintgh.db

# Rate limiting (requests per IP per window)
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_AUTH_MAX=10        # auth attempts per window

# CORS allowlist (comma-separated). Leave empty to allow all (dev only).
CORS_ORIGINS=

# ============================
# Hubtel — primary payment + SMS rail.
# In stub mode (no CLIENT_ID, or HUBTEL_MODE=stub), services/payments.js
# returns synthetic responses so local dev works without real credentials.
# ============================
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=PaintGH
HUBTEL_MERCHANT_ACCOUNT=        # POS / Receive Money merchant account number
HUBTEL_CALLBACK_URL=http://localhost:3000/api/payments/callback
HUBTEL_CALLBACK_SECRET=         # shared secret for HMAC-SHA256 callback verification
HUBTEL_MODE=                    # leave empty for live (when keys set); 'stub' to force stub

# Email provider (resend | sendgrid | mailgun | empty for stub)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@paintgh.com

# Uploads (local | s3 | r2)
UPLOADS_DRIVER=local
UPLOADS_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=
UPLOADS_PUBLIC_URL=

# Logging (debug | info | warn | error)
LOG_LEVEL=debug
